{
  "name": "vietphuong-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "sync-web": "node scripts/sync-web.mjs",
    "prestart": "npm run sync-web",
    "start": "ng serve --port 8100",
    "prebuild": "npm run sync-web",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prebuild:web": "npm run sync-web",
    "build:web": "ng build --configuration web",
    "prebuild:device": "npm run sync-web",
    "build:device": "ng build --configuration device",
    "cap:sync": "npm run build:device && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@angular/animations": "~18.2.14",
    "@angular/common": "~18.2.14",
    "@angular/compiler": "~18.2.14",
    "@angular/core": "~18.2.14",
    "@angular/forms": "~18.2.14",
    "@angular/platform-browser": "~18.2.14",
    "@angular/platform-browser-dynamic": "~18.2.14",
    "@angular/router": "~18.2.14",
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.2",
    "@ionic/angular": "^8.4.0",
    "ionicons": "^7.4.0",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.21",
    "@angular/cli": "~18.2.21",
    "@angular/compiler-cli": "~18.2.14",
    "@capacitor/cli": "^6.2.0",
    "typescript": "~5.5.4"
  }
}
